# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# ===========================================
# REDIS
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# AUTH
# ===========================================
AUTH_SECRET="your-auth-secret-min-32-chars-here"
JWT_SECRET="your-jwt-secret-min-32-chars-here"
ENCRYPTION_KEY="your-32-byte-hex-key-here-abc"

# ===========================================
# MERCADO PAGO
# ===========================================
# Sandbox (desenvolvimento)
MP_ACCESS_TOKEN="TEST-xxxx"
MP_PUBLIC_KEY="TEST-xxxx"
MP_WEBHOOK_SECRET=""

# Produção
# MP_ACCESS_TOKEN="APP-xxxx"
# MP_PUBLIC_KEY="APP-xxxx"
# MP_WEBHOOK_SECRET="your-webhook-secret"

# ===========================================
# E-MAIL (RESEND)
# ===========================================
RESEND_API_KEY="re_xxxx"

# ===========================================
# URLs
# ===========================================
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:3001"
API_PORT="3001"

# ===========================================
# OAUTH (Google)
# ===========================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# STORAGE (Cloudflare R2)
# ===========================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ===========================================
# SENTRY
# ===========================================
SENTRY_DSN=""

# ===========================================
# NODE_ENV
# ===========================================
NODE_ENV="development"
